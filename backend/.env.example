# Copy this file to .env and fill in your own values.
# .env is listed in .gitignore and must NEVER be committed.
PORT=3000
NODE_ENV=development

# Neon > Connect > pooled connection string (use the DEVELOPMENT branch locally).
DATABASE_URL=

# Long random string used to sign login tokens (at least 32 characters).
# Generate one with:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# Use a DIFFERENT value on Vercel.
JWT_SECRET=

# Frontend origins allowed by CORS, comma-separated, no trailing slash.
# On Vercel: http://localhost:8080,https://YOUR-WEB-PROJECT.vercel.app
CORS_ORIGINS=http://localhost:8080

# Cloudflare Turnstile. Locally use Cloudflare's official TEST secret below (always passes).
# On Vercel put your REAL secret key from the Cloudflare dashboard.
TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA
